rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fonction pour vérifier si l'utilisateur est admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'miroidi40@gmail.com';
    }
    
    // Permettre l'accès en lecture/écriture pour le développement
    // ⚠️ À restreindre en production !
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Collection installs - accessible aux utilisateurs authentifiés et aux admins
    match /installs/{installId} {
      allow read, write: if request.auth != null || isAdmin();
    }
    
    // Collection users - accessible aux utilisateurs authentifiés et aux admins
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin(); // Les admins peuvent lire tous les users
    }
    
    // Collection goals - accessible aux utilisateurs authentifiés et aux admins
    match /goals/{goalId} {
      allow read, write: if request.auth != null || isAdmin();
    }
    
    // Collection tasks - accessible aux utilisateurs authentifiés et aux admins
    match /tasks/{taskId} {
      allow read, write: if request.auth != null || isAdmin();
    }
    
    // Collection user_data - accessible aux utilisateurs authentifiés et aux admins
    match /user_data/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin(); // Les admins peuvent lire tous les user_data
    }
    
    // Collection traffic_visits - accessible uniquement aux admins
    match /traffic_visits/{visitId} {
      allow read, write: if isAdmin();
    }
    
    // Collection traffic_stats - accessible uniquement aux admins
    match /traffic_stats/{statsId} {
      allow read, write: if isAdmin();
    }
  }
}
